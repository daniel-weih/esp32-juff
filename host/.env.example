# qwen-audio-agent stays loopback-only. The bridge is its only LAN-facing client.
QWEN_GATEWAY_URL=http://127.0.0.1:3101
QWEN_SESSION_ID=esp32-main
QWEN_TAKEOVER=false

# The BLE path does not need a LAN listener. Change this to 0.0.0.0 only when
# explicitly enabling the authenticated Wi-Fi fallback.
JUFF_BRIDGE_HOST=127.0.0.1
JUFF_BRIDGE_PORT=8765
JUFF_DEVICE_PATH=/device

# bootstrap_macos.sh replaces this value with a private random token.
JUFF_DEVICE_TOKEN=replace-with-a-random-device-token
